# fsi-doc-intake: all configuration in one place.
# setup.py writes ./.env in your workspace from ./design-spec.md; values not
# set there fall back to the defaults below.

# --- GCP project & region (Gemini on Vertex AI) ---
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# Use an in-region location (for example europe-west4) if documents must stay in a region.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Models ---
MODEL_NAME=gemini-3.8-flash
# Split + extraction model (multimodal; empty = MODEL_NAME).
EXTRACTION_MODEL_NAME=
# gemini (default) | documentai (opt-in stub, see references/document-ai.md)
EXTRACTOR=gemini

# --- Domain pack & documents ---
# Pack name under assets/packs/ (small-business-loan | trade-finance | your own).
PACK=small-business-loan
# Or any pack folder (schema.json + rules.yaml [+ samples/]); wins over PACK.
PACK_PATH=
# Empty = the pack's samples/ folder. A local folder or gs://bucket[/prefix].
DOCUMENTS_SOURCE=

# --- Review lanes ---
# confidence >= TAU_HIGH: auto; >= TAU_LOW: review; below (or missing required): reject.
TAU_HIGH=0.9
TAU_LOW=0.5

# --- Workflow state (review, repair & resume) ---
# memory (Quick start) | local (JSON file) | firestore (existing database)
STATE_BACKEND=memory
LOCAL_STATE_PATH=.doc_intake_state.json
FIRESTORE_DATABASE=(default)

# --- Approved record output ---
# local (OUTPUT_DIR) | bigquery (BQ_TABLE, must exist) | gcs (OUTPUT_GCS_URI)
OUTPUT_DESTINATION=local
OUTPUT_DIR=records
BQ_TABLE=
OUTPUT_GCS_URI=

# --- Optional LLM-as-judge on each response (adds one model call per turn) ---
LLM_JUDGE=off
JUDGE_MODEL=
