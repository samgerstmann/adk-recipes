# fsi-small-business-loan: all configuration in one place.
# setup.py writes ./.env in your workspace from ./design-spec.md; values not
# set there fall back to the defaults below.

# --- GCP project & region (Gemini on Vertex AI) ---
GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# Use an in-region location (for example europe-west4) if data must stay in a region.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# --- Models ---
# Orchestrator + sub-agents (any multimodal Gemini model at GOOGLE_CLOUD_LOCATION).
MODEL_NAME=gemini-3.8-flash
# LLM-as-judge model (empty = MODEL_NAME). LLM_JUDGE=off disables the gate.
JUDGE_MODEL=
LLM_JUDGE=on

# --- Workflow state (repair & resume) ---
# memory    : in-process, resets when adk web restarts (Quick start default)
# local     : JSON file at LOCAL_STATE_PATH (survives restarts, editable)
# firestore : Firestore database FIRESTORE_DATABASE, collection process_states
STATE_BACKEND=memory
LOCAL_STATE_PATH=.loan_state.json
FIRESTORE_DATABASE=small-business-loan-states

# --- Applications ---
# Empty = bundled sample PDFs. A local folder, or gs://bucket[/prefix].
APPLICATIONS_SOURCE=
# Empty = bundled assets/eligibility_rules.json.
ELIGIBILITY_RULES_PATH=

# --- Debugging ---
# 1 = log every sub-agent model turn (tool calls / text) at INFO level.
LOAN_AGENT_TRACE=0
